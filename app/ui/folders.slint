import { LibraryState, PreferencesState } from "state.slint";
import { TextButton } from "controls.slint";
import { CatalogView, CatalogDetails } from "library.slint";
export component FoldersView inherits Rectangle {
    if LibraryState.detail-key!="": CatalogDetails {
    }
    if LibraryState.detail-key=="" && LibraryState.group-grid.length>0: CatalogView {
    }
    if !LibraryState.catalog-loading && LibraryState.detail-key=="" && LibraryState.group-grid.length==0: Rectangle {
        x: max(0px,(root.width - 320px)/2);
        y: max(0px,(root.height - 112px)/2);
        width: min(320px,root.width);
        height: 112px;
        VerticalLayout {
            spacing: 16px;
            alignment: center;
            Text {
                text: LibraryState.search!="" ? "No folders match your search." : "Add a music folder to start browsing.";
                color: PreferencesState.ink.with-alpha(0.65);
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                TextButton {
                    text: LibraryState.search!="" ? "Clear search" : "Add music folder";
                    clicked=>{
                        if LibraryState.search!="" {
                            LibraryState.search="";
                            LibraryState.browse();
                        } else {
                            LibraryState.add-folder();
                        }
                    }
                }
            }
        }
    }
}
