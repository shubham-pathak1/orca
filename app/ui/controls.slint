import { AppState, PlayerState, PreferencesState } from "state.slint";
import { Icons } from "icons.slint";
import { FallbackCovers } from "fallback-covers.slint";
// Common activation semantics for custom controls and virtualized rows.
export component ActionFocus inherits FocusScope {
    in property<string> layer: "browse";
    callback activated();
    callback context-menu();
    enabled: AppState.layer-enabled(root.layer);
    key-pressed(event)=>{
        if !event.modifiers.control && !event.modifiers.alt && (event.text=="\n" || event.text==" ") {
            if !event.repeat {
                root.activated();
            }
            return accept;
        }
        if event.modifiers.shift && event.text==Key.F10 {
            root.context-menu();
            return accept;
        }
        return reject;
    }
}

export component CoverImage inherits Image {
    in property<image> artwork;
    in property<bool> missing: true;
    private property<float> physical-edge: max(root.width,root.height)/1px * AppState.display-dpr;
    private property<image> fallback: physical-edge<=32 ? FallbackCovers.cover-32 : physical-edge<=64 ? FallbackCovers.cover-64 : physical-edge<=128 ? FallbackCovers.cover-128 : physical-edge<=256 ? FallbackCovers.cover-256 : physical-edge<=512 ? FallbackCovers.cover-512 : physical-edge<=1024 ? FallbackCovers.cover-1024 : Icons.cover;
    source: root.artwork.width>0 || !root.missing ? root.artwork : root.fallback;
    image-fit: cover;
}

export component SearchField inherits Rectangle {
    in-out property<string> text;
    in property<string> placeholder-text;
    out property<bool> has-focus: input.has-focus;
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: root.placeholder-text;
    accessible-value: root.text;
    changed has-focus=>{
        AppState.text-input-focused=self.has-focus;
        AppState.search-input-focused=self.has-focus;
    }
    init=>{
        if AppState.search-focus-pending && root.visible {
            input.focus();
            input.select-all();
            AppState.text-input-focused=true;
            AppState.search-input-focused=true;
        }
    }
    private property<int> focus-request: AppState.search-focus-request;
    changed focus-request=>{
        if root.visible {
            input.focus();
            input.select-all();
            AppState.text-input-focused=true;
            AppState.search-input-focused=true;
        }
    }
    callback edited();
    height: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: input.has-focus ? PreferencesState.accent.with-alpha(0.34) : PreferencesState.ink.with-alpha(0.1020);
    background: PreferencesState.ink.with-alpha(0.0392);
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.placeholder-text;
        visible: root.text=="";
        color: PreferencesState.ink.with-alpha(PreferencesState.light-theme ? max(0.65,0.3804) : 0.3804);
        font-size: 14px*PreferencesState.scale;
        vertical-alignment: center;
    }
    input:=TextInput {
        enabled: AppState.focus-layer=="browse";
        x: 12px;
        y: 0px;
        width: parent.width - (root.text=="" ? 24px : 44px);
        height: parent.height;
        text<=>root.text;
        color: PreferencesState.ink;
        font-size: 14px*PreferencesState.scale;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: PreferencesState.accent.with-alpha(0.3);
        selection-foreground-color: PreferencesState.ink;
        edited=>{
            root.edited();
        }
    }
    if root.text!="": Rectangle {
        x: parent.width - 32px;
        y: 8px;
        width: 24px;
        height: 24px;
        Image {
            x: 4px;
            y: 4px;
            width: 16px;
            height: 16px;
            source: Icons.close;
            colorize: PreferencesState.ink;
            opacity: 0.65;
        }
        TouchArea {
            clicked=>{
                AppState.unfocus();
                root.text="";
                root.edited();
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property<bool> enabled: true;
    in property<bool> dialog-control: false;
    in property<string> layer: "browse";
    in property<string> label;
    if PreferencesState.show-tooltips && root.label!="": Tooltip {
        text: @markdown("\{root.label}");
    }
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default=>{
        if root.enabled {
            root.clicked();
        }
    }
    focus:=ActionFocus {
        layer: root.dialog-control ? "dialog" : root.layer;
        enabled: root.enabled && AppState.layer-enabled(root.dialog-control ? "dialog" : root.layer);
        activated=>{
            root.clicked();
        }
    }
    in property<bool> dark: false;
    private property<color> ink: root.dark ? white : PreferencesState.ink;
    private property<color> inverse-ink: root.dark ? black : PreferencesState.inverse-ink;
    private property<color> accent: root.dark ? PlayerState.player-accent : PreferencesState.accent;
    in property <image> icon;
    in property<bool> filled-active: false;
    private property<bool> active-tile: root.active && root.filled-active;
    private property<length> active-edge: floor(min(root.width - 4px,root.icon-size*1.35)/1px*AppState.display-dpr)/AppState.display-dpr*1px;
    in property<length> icon-size: 20px;
    in property <bool> round: false;
    in property <bool> outlined: false;
    in property <bool> primary: false;
    in property<color> primary-background: root.ink;
    in property<color> primary-foreground: root.inverse-ink;
    in property <bool> active: false;
    out property<bool> has-hover: pointer.has-hover;
    out property<bool> has-focus: focus.has-focus;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: root.round ? root.width / 2 : 6px;
    background: root.primary ? root.primary-background : root.active-tile ? transparent : root.active ? root.accent.with-alpha(0.12) : pointer.has-hover ? root.ink.with-alpha(0.0784) : transparent;
    border-width: focus.has-focus && AppState.keyboard-navigation ? 2px : root.outlined ? 1px : 0px;
    border-color: focus.has-focus && AppState.keyboard-navigation ? root.ink : root.ink.with-alpha(0.1020);
    if root.active-tile: Rectangle {
        width: root.active-edge;
        height: self.width;
        border-radius: 6px;
        x: floor((parent.width - self.width)/2/1px*AppState.display-dpr+0.5)/AppState.display-dpr*1px;
        y: floor((parent.height - self.height)/2/1px*AppState.display-dpr+0.5)/AppState.display-dpr*1px;
        background: root.accent.with-alpha(pointer.has-hover ? 0.78 : 0.62);
    }
    Image {
        width: root.icon-size;
        height: self.width;
        x: floor((parent.width - self.width)/2/1px*AppState.display-dpr+0.5)/AppState.display-dpr*1px;
        y: floor((parent.height - self.height)/2/1px*AppState.display-dpr+0.5)/AppState.display-dpr*1px;
        source: root.icon;
        colorize: root.primary ? root.primary-foreground : root.active-tile ? (root.dark ? #090a0c : PreferencesState.base) : root.active ? root.accent : root.ink;
        opacity: root.primary || root.active || pointer.has-hover ? 1 : root.layer=="full" ? 0.82 : 0.64;
    }
    pointer := TouchArea {
        enabled: root.enabled && (root.layer!="full" || root.opacity>0.01);
        changed has-hover=>{
            if root.layer=="full" {
                PlayerState.player-hovering-controls=self.has-hover;
                if self.has-hover {
                    PlayerState.player-activity();
                }
            }
        }
        changed mouse-x=>{
            if self.has-hover && root.layer=="full" {
                PlayerState.player-activity();
            }
        }
        changed mouse-y=>{
            if self.has-hover && root.layer=="full" {
                PlayerState.player-activity();
            }
        }
        moved=>{
            if root.layer=="full" {
                PlayerState.player-activity();
            }
        }
        clicked => {
            if root.layer=="full" {
                PlayerState.player-activity();
            }
            AppState.keyboard-navigation=false;
            focus.focus();
            root.clicked();
        }
    }
}

export component TextButton inherits Rectangle {
    in property<bool> dialog-control: false;
    in property<string> layer: "browse";
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default=>{
        if root.enabled {
            root.clicked();
        }
    }
    focus:=ActionFocus {
        layer: root.dialog-control ? "dialog" : root.layer;
        enabled: root.enabled && AppState.layer-enabled(root.dialog-control ? "dialog" : root.layer);
        activated=>{
            root.clicked();
        }
    }
    in property<bool> dark: false;
    private property<color> ink: root.dark ? white : PreferencesState.ink;
    private property<color> inverse-ink: root.dark ? black : PreferencesState.inverse-ink;
    private property<color> accent: root.dark ? PlayerState.player-accent : PreferencesState.accent;
    in property<bool> enabled: true;
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    callback clicked();
    height: 40px;
    width: max(100px,label.preferred-width+(root.icon.width>0 ? 56px : 32px));
    border-radius: 6px;
    border-width: focus.has-focus && AppState.keyboard-navigation ? 2px : 1px;
    border-color: focus.has-focus && AppState.keyboard-navigation ? root.ink : root.ink.with-alpha(0.3765);
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary ? root.ink : pointer.has-hover ? root.ink.with-alpha(0.0784) : transparent;
    if root.icon.width>0: Image {
        x: 12px;
        y: (parent.height - 16px)/2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.primary ? root.inverse-ink : root.ink;
    }
    label := Text {
        x: root.icon.width>0 ? 28px : 0px;
        width: parent.width - self.x;
        text: root.text;
        color: root.primary ? root.inverse-ink : root.ink;
        font-size: 14px*PreferencesState.scale;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 600;
    }
    pointer := TouchArea {
        enabled: root.enabled && (root.layer!="full" || root.opacity>0.01);
        changed has-hover=>{
            if root.layer=="full" {
                PlayerState.player-hovering-controls=self.has-hover;
                if self.has-hover {
                    PlayerState.player-activity();
                }
            }
        }
        changed mouse-x=>{
            if self.has-hover && root.layer=="full" {
                PlayerState.player-activity();
            }
        }
        changed mouse-y=>{
            if self.has-hover && root.layer=="full" {
                PlayerState.player-activity();
            }
        }
        moved=>{
            if root.layer=="full" {
                PlayerState.player-activity();
            }
        }
        clicked => {
            if root.layer=="full" {
                PlayerState.player-activity();
            }
            AppState.keyboard-navigation=false;
            focus.focus();
            root.clicked();
        }
    }
}

export component ToggleSwitch inherits Rectangle {
    in property<string> label;
    forward-focus: focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default=>{
        root.checked=!root.checked;
        root.toggled();
    }
    focus:=ActionFocus {
        activated=>{
            root.checked=!root.checked;
            root.toggled();
        }
    }
    if AppState.keyboard-navigation && focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width+6px;
        height: root.height+6px;
        border-width: 2px;
        border-radius: 15px;
        border-color: PreferencesState.ink;
    }
    in-out property<bool> checked;
    callback toggled();
    width: 42px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.checked ? PreferencesState.ink : PreferencesState.ink.with-alpha(0.2510);
    background: root.checked ? PreferencesState.ink : PreferencesState.ink.with-alpha(0.0784);
    Rectangle {
        x: root.checked ? 22px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? PreferencesState.base : PreferencesState.ink;
        animate x {
            duration: 100ms;
            easing: ease-out;
        }
    }
    TouchArea {
        clicked=> {
            focus.focus();
            root.checked=!root.checked;
            root.toggled();
        }
    }
}

export component AccentSlider inherits Rectangle {
    in property<string> label;
    forward-focus: focus;
    accessible-role: AccessibleRole.slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-action-set-value(v)=>{
        if v.is-float() {
            root.value=clamp(v.to-float(),root.minimum,root.maximum);
            root.changed(root.value);
        }
    }
    focus:=FocusScope {
        enabled: AppState.focus-layer=="browse";
        key-pressed(event)=>{
            if event.text==Key.LeftArrow || event.text==Key.DownArrow {
                root.value=max(root.minimum,root.value - (root.maximum - root.minimum)/100);
                root.changed(root.value);
                return accept;
            }
            if event.text==Key.RightArrow || event.text==Key.UpArrow {
                root.value=min(root.maximum,root.value + (root.maximum - root.minimum)/100);
                root.changed(root.value);
                return accept;
            }
            if event.text==Key.Home {
                root.value=root.minimum;
                root.changed(root.value);
                return accept;
            }
            if event.text==Key.End {
                root.value=root.maximum;
                root.changed(root.value);
                return accept;
            }
            return reject;
        }
    }
    if AppState.keyboard-navigation && focus.has-focus: Rectangle {
        border-width: 2px;
        border-radius: 6px;
        border-color: PreferencesState.ink;
    }
    in property<float> minimum;
    in property<float> maximum: 100;
    in-out property<float> value;
    callback changed(float);
    height: 36px;
    private property<float> progress: maximum>minimum ? clamp((value - minimum)/(maximum - minimum),0,1) : 0;
    Rectangle {
        x: 7px;
        y: (root.height - 6px)/2;
        width: root.width - 14px;
        height: 6px;
        border-radius: 3px;
        background: PreferencesState.ink.with-alpha(0.1490);
        border-width: 1px;
        border-color: PreferencesState.ink.with-alpha(0.2510);
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width*root.progress;
            border-radius: 3px;
            background: PreferencesState.accent;
        }
    }
    Rectangle {
        x: 7px+(root.width - 14px)*root.progress - 7px;
        y: (root.height - 14px)/2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: PreferencesState.accent;
    }
    TouchArea {
        function update-value() {
            root.value=root.minimum+clamp((self.mouse-x - 7px)/(self.width - 14px),0,1)*(root.maximum - root.minimum);
            root.changed(root.value);
        }
        pointer-event(event)=>{
            if event.kind==PointerEventKind.down {
                focus.focus();
                self.update-value();
            }
        }
        moved=>{
            if self.pressed {
                self.update-value();
            }
        }
    }
}

export component PlaybackControls inherits HorizontalLayout {
    in property<string> layer: "browse";
    in property<bool> dark: false;
    private property<color> ink: root.dark ? white : PreferencesState.ink;
    private property<color> inverse-ink: root.dark ? black : PreferencesState.inverse-ink;
    private property<color> accent: root.dark ? PlayerState.player-accent : PreferencesState.accent;
    in property <bool> large;
    in property <bool> prominent: false;
    private property<bool> hero: root.prominent && root.large;
    spacing: root.hero ? 12px : root.prominent ? 14px : root.large ? 16px : 12px;
    alignment: center;
    cross-axis-alignment: center;
    out property<length> secondary-icon-size: root.hero ? 25px : root.prominent ? 24px : 20px;
    out property<length> secondary-button-size: root.hero ? 48px : root.prominent ? 44px : 40px;
    IconButton {
        enabled: root.opacity>0.01;
        label: "Shuffle";
        layer: root.layer;
        dark: root.dark;
        icon: Icons.shuffle;
        filled-active: true;
        icon-size: root.secondary-icon-size;
        width: root.secondary-button-size;
        height: self.width;
        round: true;
        active: PlayerState.shuffle;
        clicked => {
            PlayerState.command("shuffle",0);
        }
    }
    IconButton {
        enabled: root.opacity>0.01;
        label: "Previous track";
        layer: root.layer;
        dark: root.dark;
        icon: Icons.previous;
        icon-size: root.secondary-icon-size;
        width: root.secondary-button-size;
        height: self.width;
        round: true;
        clicked => {
            PlayerState.command("previous",0);
        }
    }
    IconButton {
        enabled: root.opacity>0.01;
        layer: root.layer;
        dark: root.dark;
        label: PlayerState.playing ? "Pause" : "Play";
        icon: PlayerState.playing ? Icons.pause : Icons.play;
        icon-size: root.hero ? 32px : root.prominent ? 30px : root.large ? 24px : 20px;
        round: true;
        primary: true;
        primary-background: root.ink;
        primary-foreground: root.inverse-ink;
        width: root.hero ? 64px : root.prominent ? 56px : root.large ? 52px : 44px;
        height: self.width;
        clicked => {
            PlayerState.command("toggle",0);
        }
    }
    IconButton {
        enabled: root.opacity>0.01;
        label: "Next track";
        layer: root.layer;
        dark: root.dark;
        icon: Icons.next;
        icon-size: root.secondary-icon-size;
        width: root.secondary-button-size;
        height: self.width;
        round: true;
        clicked => {
            PlayerState.command("next",0);
        }
    }
    IconButton {
        enabled: root.opacity>0.01;
        label: PlayerState.repeat==2 ? "Repeat one" : PlayerState.repeat==1 ? "Repeat all" : "Repeat off";
        layer: root.layer;
        dark: root.dark;
        icon: PlayerState.repeat==2 ? Icons.repeatOne : Icons.repeat;
        filled-active: true;
        icon-size: root.secondary-icon-size;
        width: root.secondary-button-size;
        height: self.width;
        round: true;
        active: PlayerState.repeat>0;
        clicked => {
            PlayerState.command("repeat",0);
        }
    }
}

export component SeekBar inherits Rectangle {
    in property<bool> dark: false;
    private property<color> ink: root.dark ? white : PreferencesState.ink;
    private property<color> inverse-ink: root.dark ? black : PreferencesState.inverse-ink;
    private property<color> accent: root.dark ? PlayerState.player-accent : PreferencesState.accent;
    in property <bool> stacked;
    forward-focus: seek-focus;
    seek-focus:=FocusScope {
        enabled: AppState.layer-enabled(root.stacked ? "full" : "browse") && PlayerState.duration>0;
        key-pressed(event)=>{
            if event.text==Key.LeftArrow {
                PlayerState.seek(max(0,PlayerState.position - 5000));
                return accept;
            }
            if event.text==Key.RightArrow {
                PlayerState.seek(min(PlayerState.duration,PlayerState.position+5000));
                return accept;
            }
            return reject;
        }
    }
    if AppState.keyboard-navigation && seek-focus.has-focus: Rectangle {
        border-width: 2px;
        border-color: root.ink;
        border-radius: 4px;
    }
    private property <float> drag-position;
    private property <float> displayed: pointer.pressed ? root.drag-position : PlayerState.position;
    private property <float> progress: PlayerState.duration>0 ? clamp(root.displayed/PlayerState.duration,0,1) : 0;
    height: root.stacked ? 72px : 28px;
    HorizontalLayout {
        y: 0;
        height: root.stacked ? root.height - 26px : root.height;
        spacing: 12px;
        if !root.stacked: Text {
            width: 42px;
            text: PlayerState.elapsed;
            color: root.ink.with-alpha(PreferencesState.light-theme && !root.dark ? max(0.65,0.5020) : 0.5020);
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        track := Rectangle {
            horizontal-stretch: 1;
            if PreferencesState.seek-style=="waveform": Image {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                source: PlayerState.waveform;
                image-fit: fill;
                colorize: root.ink.with-alpha(0.1608);
            }
            if PreferencesState.seek-style=="waveform": Rectangle {
                x: 0px;
                y: 0px;
                height: parent.height;
                width: parent.width*root.progress;
                clip: true;
                Image {
                    x: 0px;
                    y: 0px;
                    width: track.width;
                    height: track.height;
                    source: PlayerState.waveform;
                    image-fit: fill;
                    colorize: root.accent;
                }
            }
            if PreferencesState.seek-style!="waveform": Rectangle {
                y: (parent.height - (root.stacked ? 6px : 3px))/2;
                height: root.stacked ? 6px : 3px;
                border-radius: root.stacked ? 3px : 1.5px;
                clip: true;
                background: root.ink.with-alpha(0.1608);
                Rectangle {
                    x: 0px;
                    y: 0px;
                    height: parent.height;
                    width: parent.width*root.progress;
                    border-radius: parent.border-radius;
                    background: root.accent;
                }
            }
            pointer := TouchArea {
                enabled: PlayerState.duration>0 && AppState.layer-enabled(root.stacked ? "full" : "browse") && (!root.stacked || root.opacity>0.01);
                changed has-hover=>{
                    if root.stacked {
                        PlayerState.player-hovering-controls=self.has-hover;
                        if self.has-hover {
                            PlayerState.player-activity();
                        }
                    }
                }
                mouse-cursor: MouseCursor.pointer;
                changed pressed=>{
                    if root.stacked {
                        PlayerState.player-interacting=self.pressed;
                        PlayerState.player-activity();
                    }
                }
                pointer-event(event) => {
                    if event.kind==PointerEventKind.down {
                        root.drag-position=clamp(self.mouse-x/self.width,0,1)*PlayerState.duration;
                    }
                    if event.kind==PointerEventKind.up {
                        PlayerState.seek(root.drag-position);
                    }
                }
                moved => {
                    if root.stacked {
                        PlayerState.player-activity();
                    }
                    if self.pressed {
                        root.drag-position=clamp(self.mouse-x/self.width,0,1)*PlayerState.duration;
                    }
                }
            }
            if PreferencesState.show-tooltips && PlayerState.duration>0 && (pointer.has-hover || pointer.pressed): Rectangle {
                private property<int> seconds: floor(clamp(pointer.mouse-x/max(1px,pointer.width),0,1)*PlayerState.duration/1000);
                private property<int> hours: floor(self.seconds/3600);
                private property<int> minutes: floor(self.seconds/60) - self.hours*60;
                private property<int> remainder: self.seconds - floor(self.seconds/60)*60;
                x: clamp(pointer.mouse-x - self.width/2,0px,max(0px,parent.width - self.width));
                y: -30px;
                height: 24px;
                width: timestamp.preferred-width+16px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.ink.with-alpha(0.18);
                background: root.dark ? #171719 : PreferencesState.raised-panel;
                timestamp:=Text {
                    text: (parent.hours>0 ? parent.hours+":"+(parent.minutes<10 ? "0" : "") : "")+parent.minutes+":"+(parent.remainder<10 ? "0" : "")+parent.remainder;
                    color: root.ink;
                    font-size: 12px*PreferencesState.scale;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if !root.stacked: Text {
            width: 42px;
            text: PlayerState.total;
            color: root.ink.with-alpha(PreferencesState.light-theme && !root.dark ? max(0.65,0.5020) : 0.5020);
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    if root.stacked: HorizontalLayout {
        y: root.height - 18px;
        height: 18px;
        Text {
            text: PlayerState.elapsed;
            color: root.ink.with-alpha(PreferencesState.light-theme && !root.dark ? max(0.65,0.5020) : 0.5020);
            font-size: 12px;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: PlayerState.total;
            color: root.ink.with-alpha(PreferencesState.light-theme && !root.dark ? max(0.65,0.5020) : 0.5020);
            font-size: 12px;
            horizontal-alignment: right;
        }
    }
}

export component VolumeControl inherits Rectangle {
    in property<string> layer: "browse";
    forward-focus: volume-focus;
    accessible-role: AccessibleRole.slider;
    accessible-label: "Volume";
    accessible-value: round(PlayerState.volume*100);
    volume-focus:=FocusScope {
        enabled: AppState.layer-enabled(root.layer) && !PlayerState.output-unprocessed;
        key-pressed(event)=>{
            if event.text==Key.UpArrow || event.text==Key.RightArrow {
                PlayerState.volume-changed(min(1,PlayerState.volume+0.05));
                return accept;
            }
            if event.text==Key.DownArrow || event.text==Key.LeftArrow {
                PlayerState.volume-changed(max(0,PlayerState.volume - 0.05));
                return accept;
            }
            if event.text==Key.Home {
                PlayerState.volume-changed(0);
                return accept;
            }
            if event.text==Key.End {
                PlayerState.volume-changed(1);
                return accept;
            }
            return reject;
        }
    }
    if AppState.keyboard-navigation && volume-focus.has-focus: Rectangle {
        border-width: 2px;
        border-color: root.ink;
        border-radius: 6px;
    }
    in property<bool> dark: false;
    private property<color> ink: root.dark ? white : PreferencesState.ink;
    private property<color> inverse-ink: root.dark ? black : PreferencesState.inverse-ink;
    private property<color> accent: root.dark ? PlayerState.player-accent : PreferencesState.accent;
    width: 32px;
    height: 32px;
    private property<bool> open;
    private property<float> last-volume: 1;
    Image {
        x: 6px;
        y: 6px;
        width: 20px;
        height: 20px;
        source: PlayerState.volume==0 ? Icons.mute : Icons.volume;
        colorize: root.ink;
        opacity: PlayerState.output-unprocessed ? 0.35 : 0.7;
    }
    if PreferencesState.show-tooltips && PlayerState.output-unprocessed: Tooltip {
        text: @markdown("Unprocessed output uses 100% app volume. Adjust volume on your device.");
    }
    // Includes the gap; popup hover/drag separately keeps the close timer stopped.
    area:=TouchArea {
        enabled: !PlayerState.output-unprocessed;
        moved=>{
            if root.layer=="full" {
                PlayerState.player-activity();
            }
        }
        x: -4px;
        y: root.open ? -144px : 0px;
        width: 40px;
        height: root.open ? 176px : 32px;
        clicked=>{
            if self.mouse-y>=self.height - 32px {
                if PlayerState.volume>0 {
                    root.last-volume=PlayerState.volume;
                }
                PlayerState.volume-changed(PlayerState.volume==0 ? root.last-volume : 0);
                root.open=true;
            }
        }
        scroll-event(event)=>{
            PlayerState.volume-changed(clamp(PlayerState.volume+(event.delta-y>0px ? 0.05 : -0.05),0,1));
            return accept;
        }
        changed has-hover=>{
            if self.has-hover {
                root.open=true;
            }
        }
    }
    // Keep the touch region instantiated so its hover state can control the timer.
    popup:=Rectangle {
        visible: root.open && !PlayerState.output-unprocessed;
        x: -3px;
        y: -144px;
        width: 38px;
        height: 136px;
        background: root.dark ? #171719 : PreferencesState.raised-panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.ink.with-alpha(0.0784);
        Rectangle {
            x: 17px;
            y: 12px;
            width: 3px;
            height: 112px;
            background: root.ink.with-alpha(0.2000);
            Rectangle {
                y: parent.height*(1 - PlayerState.volume);
                height: parent.height*PlayerState.volume;
                background: root.accent;
            }
        }
        Rectangle {
            x: 14px;
            y: 12px+(1 - PlayerState.volume)*112px - 5px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.accent;
        }
        slider:=TouchArea {
            changed pressed=>{
                if root.layer=="full" {
                    PlayerState.player-interacting=self.pressed;
                    PlayerState.player-activity();
                }
            }
            pointer-event(event)=>{
                if event.kind==PointerEventKind.down {
                    PlayerState.volume-changed(clamp(1 - (self.mouse-y - 12px)/112px,0,1));
                }
            }
            moved=>{
                if self.pressed {
                    PlayerState.volume-changed(clamp(1 - (self.mouse-y - 12px)/112px,0,1));
                }
            }
            clicked=>{
                PlayerState.volume-changed(clamp(1 - (self.mouse-y - 12px)/112px,0,1));
            }
            scroll-event(event)=>{
                PlayerState.volume-changed(clamp(PlayerState.volume+(event.delta-y>0px ? 0.05 : -0.05),0,1));
                return accept;
            }
        }
    }
    Timer {
        interval: 500ms;
        running: root.open && !area.has-hover && !slider.has-hover && !slider.pressed;
        triggered=>{
            root.open=false;
        }
    }
}

// Crossfade cached ambience only when its source changes, then release the old
// image reference. No blur or artwork decoding runs on the UI thread.
export component AmbientBackground inherits Rectangle {
    in property<image> source;
    in property<float> strength: 0.06;
    in property<bool> subtle: true;
    in property<bool> animate: true;
    private property<image> shown;
    private property<image> previous;
    private property<float> blend: 1;
    init=>{
        self.shown=self.source;
        self.previous=self.source;
    }
    changed source=>{
        self.previous=self.shown;
        self.shown=self.source;
        self.blend=self.animate ? 0 : 1;
    }
    Timer {
        interval: 16ms;
        running: root.blend<1 && !AppState.window-hidden;
        triggered=>{
            root.blend=min(1,root.blend+0.125);
            if root.blend>=1 {
                root.previous=root.shown;
            }
        }
    }
    if root.blend<1: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.previous;
        image-fit: fill;
        opacity: root.strength*(1 - root.blend);
    }
    Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.shown;
        image-fit: fill;
        opacity: root.strength*root.blend;
    }
    if root.subtle: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: PreferencesState.base.with-alpha(0.8);
    }
}

// Shared title and content-advisory badge for compact and full-player layouts.
export component TrackTitle inherits Rectangle {
    in property<string> text;
    in property<bool> explicit: false;
    in property<bool> multiline: false;
    in property<length> text-size: 14px*PreferencesState.scale;
    in property<int> weight: 700;
    in property<color> ink: PreferencesState.ink;
    in property<bool> centered: false;
    in property<bool> interactive: false;
    callback activated();
    preferred-height: root.multiline ? min(measure.preferred-height,root.text-size*2.8) : measure.preferred-height;
    preferred-width: measure.preferred-width+(root.explicit ? 24px : 0px);
    private property<length> content-width: min(root.width,root.preferred-width);
    measure:=Text {
        visible: false;
        width: root.multiline ? max(1px,root.width - (root.explicit ? 24px : 0px)) : 100000px;
        wrap: root.multiline ? word-wrap : no-wrap;
        text: root.text;
        font-size: root.text-size;
        font-weight: root.weight;
    }
    title:=Text {
        x: root.centered ? (root.width - root.content-width)/2 : 0px;
        y: 0px;
        width: max(0px,root.content-width - (root.explicit ? 24px : 0px));
        height: parent.height;
        text: root.text;
        font-size: root.text-size;
        font-weight: root.weight;
        color: root.ink;
        overflow: elide;
        wrap: root.multiline ? word-wrap : no-wrap;
        horizontal-alignment: root.centered ? center : left;
        vertical-alignment: center;
    }
    if root.explicit: Rectangle {
        x: title.x+title.width+6px;
        y: (parent.height - 16px)/2;
        width: 16px;
        height: 16px;
        border-radius: 2px;
        background: root.ink.with-alpha(0.18);
        Text {
            text: "E";
            color: root.ink;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.interactive: TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked=>{
            root.activated();
        }
        scroll-event(event)=>{
            if PlayerState.player-swipe(event.delta-x/1px,event.delta-y/1px) {
                return accept;
            }
            return reject;
        }
    }
    if PreferencesState.show-tooltips && root.text!="": Tooltip {
        text: @markdown("\{root.text}");
    }
}
