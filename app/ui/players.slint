import { ListView } from "std-widgets.slint";
import { AppState, LyricRender } from "state.slint";
import { Icons } from "icons.slint";
import { IconButton, PlaybackControls, SeekBar, VolumeControl, TextButton, AmbientBackground, CoverImage, ScrollMotion, ActionFocus } from "controls.slint";

component PlayerDragArea inherits TouchArea {
    callback tapped;
    callback activity;
    private property<float> start-x;
    private property<float> start-y;
    private property<bool> dragging;
    pointer-event(event) => {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            root.activity();
            self.start-x = self.mouse-x / 1px;
            self.start-y = self.mouse-y / 1px;
            self.dragging = true;
        }
        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && AppState.now.path != "" {
            AppState.keyboard-navigation = false;
            AppState.menu(AppState.now.path, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
        }
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.dragging {
            self.dragging = false;
            if !AppState.player-drag((self.mouse-x / 1px) - self.start-x, (self.mouse-y / 1px) - self.start-y) {
                AppState.player-swipe-offset = 0;
            }
        }
    }
    moved => {
        root.activity();
        if self.dragging && self.pressed {
            let dx = (self.mouse-x / 1px) - self.start-x;
            let dy = (self.mouse-y / 1px) - self.start-y;
            if abs(dx) > abs(dy) * 1.3 {
                AppState.player-swipe-offset = clamp(dx, -56, 56);
            }
        }
    }
    clicked => {
        if abs((self.mouse-x / 1px) - self.start-x) < 8 && abs((self.mouse-y / 1px) - self.start-y) < 8 {
            root.tapped();
        }
    }
    scroll-event(event) => {root.activity();AppState.player-swipe(event.delta-x / 1px, event.delta-y / 1px);return accept;}
}

export component PlayerBar inherits Rectangle {
    background:transparent;
    Rectangle {x:0px;y:0px;height:1px;background:AppState.ink.with-alpha(0.1020);}
    if root.width>=860px: HorizontalLayout {
        padding-left:20px;padding-right:20px;padding-top:8px;padding-bottom:8px;spacing:16px;
        Rectangle {
            width:280px;
            HorizontalLayout {
                y:(parent.height - self.height)/2;height:(AppState.quality-info ? 52px : 39px)*AppState.scale;spacing:12px;
                if AppState.compact-artwork: Rectangle {width:parent.height;height:parent.height;border-radius:2px;clip:true;
                    CoverImage {x:0px;y:0px;width:parent.width;height:parent.height;artwork:AppState.now.cover;missing:AppState.now.cover-missing;image-fit:cover;}
                    TouchArea {clicked => {AppState.full-player=true;} scroll-event(event)=>{if AppState.player-swipe(event.delta-x/1px,event.delta-y/1px) {return accept;} return reject;}}
                }
                Rectangle {horizontal-stretch:1;clip:true;
                    Text {x:0px;y:0px;width:parent.width;height:21px*AppState.scale;text:AppState.now.title=="" ? "No track playing" : AppState.now.title;color:AppState.ink;font-size:14px*AppState.scale;font-weight:700;overflow:elide;
                        TouchArea {clicked=>{AppState.unfocus();AppState.full-player=true;} scroll-event(event)=>{if AppState.player-swipe(event.delta-x/1px,event.delta-y/1px) {return accept;} return reject;}}}
                    HorizontalLayout {x:0px;y:21px*AppState.scale;height:18px*AppState.scale;width:parent.width;spacing:4px;alignment:start;
                        Rectangle {width:min(artist-label.preferred-width,parent.width*0.55);clip:true;
                            artist-label:=Text {width:parent.width;height:18px*AppState.scale;text:AppState.now.artist;color:AppState.ink.with-alpha(AppState.light-theme ? max(0.65,0.7216) : 0.7216);font-size:12px*AppState.scale;overflow:elide;
                                TouchArea {clicked=>{AppState.unfocus();AppState.view="artists";AppState.open-group(AppState.now.artist,"",AppState.now.artist);}}}}
                        if AppState.now.album!="": Text {text:"-";color:AppState.ink.with-alpha(AppState.light-theme ? max(0.65,0.7216) : 0.7216);font-size:12px*AppState.scale;}
                        if AppState.now.album!="": Rectangle {horizontal-stretch:1;clip:true;
                            Text {width:parent.width;height:18px*AppState.scale;text:AppState.now.album;color:AppState.ink.with-alpha(AppState.light-theme ? max(0.65,0.7216) : 0.7216);font-size:12px*AppState.scale;overflow:elide;
                                TouchArea {clicked=>{AppState.unfocus();AppState.view="albums";AppState.open-group(AppState.now.album,AppState.now.album-artist,AppState.now.album);}}}}
                    }
                    if AppState.quality-info: Text {x:0px;y:39px*AppState.scale;width:parent.width;height:13px*AppState.scale;text:AppState.now.quality;color:AppState.ink.with-alpha(AppState.light-theme ? max(0.65,0.7216) : 0.7216);font-size:10px*AppState.scale;overflow:elide;}
                }
            }
        }
        Rectangle {horizontal-stretch:1;
            SeekBar {x:(parent.width - self.width)/2;y:(parent.height - 76px)/2;width:min(840px,parent.width);height:28px;}
            PlaybackControls {x:(parent.width - self.width)/2;y:(parent.height - 76px)/2+32px;width:252px;height:44px;}
        }
        Rectangle {width:216px;
        HorizontalLayout {y:(parent.height - 40px)/2;height:40px;spacing:6px;alignment:end;
            if AppState.show-liked-songs: IconButton {label:AppState.liked ? "Unlike song" : "Like song";icon:AppState.liked ? Icons.heartFilled : Icons.heart;enabled:AppState.now.id>0;active:AppState.liked;active-icon-only:true;clicked=>{AppState.toggle-like();}}
            IconButton {label:"Add to playlist";icon:Icons.playlistAdd;enabled:AppState.now.id>0;active:AppState.playlist-picker-open;clicked => {if AppState.playlist-picker-open {AppState.playlist-picker-open=false;} else {AppState.playlist-action("open-current","");AppState.queue-open=false;}}}
            IconButton {label:"Lyrics";icon:Icons.lyrics;enabled:AppState.now.path!="";active:AppState.lyrics-open;clicked => {AppState.lyrics-open=!AppState.lyrics-open;AppState.queue-open=false;AppState.playlist-picker-open=false;}}
            IconButton {label:"Queue";icon:Icons.queue;active:AppState.queue-open;clicked => {AppState.queue-open=!AppState.queue-open;if AppState.queue-open {AppState.playlist-picker-open=false;AppState.command("queue-preview",0);}}}
            VolumeControl {y:4px;}
        }}
    }
    if root.width<860px: VerticalLayout {
        padding:12px;spacing:4px;
        HorizontalLayout {height:AppState.quality-info ? 40px : 28px;spacing:10px;
            if AppState.compact-artwork: Rectangle {width:parent.height;height:parent.height;border-radius:3px;clip:true;CoverImage {x:0px;y:0px;width:parent.width;height:parent.height;artwork:AppState.now.cover;missing:AppState.now.cover-missing;image-fit:cover;}TouchArea {clicked=>{AppState.full-player=true;}scroll-event(event)=>{if AppState.player-swipe(event.delta-x/1px,event.delta-y/1px) {return accept;}return reject;}}}
            VerticalLayout {spacing:2px;alignment:center;
                Text {text:AppState.now.title=="" ? "No track playing" : AppState.now.title;color:AppState.ink;font-size:14px*AppState.scale;font-weight:700;overflow:elide;TouchArea {clicked=>{AppState.unfocus();AppState.full-player=true;}scroll-event(event)=>{if AppState.player-swipe(event.delta-x/1px,event.delta-y/1px) {return accept;}return reject;}}}
                if AppState.quality-info: Text {text:AppState.now.quality;color:AppState.ink.with-alpha(AppState.light-theme ? 0.65 : 0.72);font-size:10px*AppState.scale;overflow:elide;}
            }
            if AppState.show-liked-songs: IconButton {label:AppState.liked ? "Unlike song" : "Like song";width:28px;height:28px;icon-size:18px;icon:AppState.liked ? Icons.heartFilled : Icons.heart;enabled:AppState.now.id>0;active:AppState.liked;active-icon-only:true;clicked=>{AppState.toggle-like();}}
            IconButton {label:"Add to playlist";width:28px;height:28px;icon-size:18px;icon:Icons.playlistAdd;enabled:AppState.now.id>0;active:AppState.playlist-picker-open;clicked=>{if AppState.playlist-picker-open {AppState.playlist-picker-open=false;} else {AppState.playlist-action("open-current","");AppState.queue-open=false;}}}
            IconButton {label:"Lyrics";width:28px;height:28px;icon-size:18px;icon:Icons.lyrics;enabled:AppState.now.path!="";active:AppState.lyrics-open;clicked=>{AppState.lyrics-open=!AppState.lyrics-open;AppState.queue-open=false;AppState.playlist-picker-open=false;}}
            IconButton {label:"Queue";width:28px;height:28px;icon:Icons.queue;active:AppState.queue-open;clicked=>{AppState.queue-open=!AppState.queue-open;if AppState.queue-open {AppState.playlist-picker-open=false;AppState.command("queue-preview",0);}}}
            VolumeControl {width:28px;height:28px;}
        }
        SeekBar {height:24px;}
        PlaybackControls {height:44px;}
    }
}

component LyricsViewport inherits Rectangle {
    callback activity;
    in property<bool> dark;
    in property<length> font-size:32px;
    private property<color> ink:root.dark ? white : AppState.ink;
    private property<bool> retryable:AppState.lyrics-status=="Oops, lyrics not found :("
        || AppState.lyrics-status=="Couldn't fetch lyrics. Please try again later.";
    clip:true;
    init=>{AppState.lyrics-width=self.width/1px;AppState.lyric-font-size=self.font-size/1px;}
    changed width=>{AppState.lyrics-width=self.width/1px;}
    changed font-size=>{AppState.lyric-font-size=self.font-size/1px;}
    resume-follow:=Timer {interval:5000ms;triggered=>{lyrics.follow=true;lyrics.follow-current();}}
    motion:=ScrollMotion {offset<=>lyrics.content-y;minimum:-max(0px,lyrics.content-height - lyrics.height);page:lyrics.height;}
    lyrics := Flickable {
        mouse-drag-pan-enabled:false;
        content-width:self.width;
        content-height:AppState.lyric-offset(AppState.lyrics.length,AppState.lyric-layout-revision)*1px;
        private property <bool> follow:true;
        function follow-current() {
            let offset=AppState.lyric-offset(max(0,AppState.active-line),AppState.lyric-layout-revision)*1px;
            let next=AppState.lyric-offset(max(0,AppState.active-line)+1,AppState.lyric-layout-revision)*1px;
            motion.snap(-clamp(offset - self.height*0.45+min(next - offset,self.height*0.8)/2,0px,max(0px,self.content-height - self.height)));
        }
        function wheel-scroll(delta:length) {
            self.follow=false;resume-follow.restart();
            motion.nudge(delta);
        }
        init=> {self.follow-current();}
        changed content-height=> {if self.follow {self.follow-current();}}
        private property <int> active-line: AppState.active-line;
        changed active-line => {if self.follow {self.follow-current();}}
        private property<int> layout-revision:AppState.lyric-layout-revision;
        changed layout-revision=>{if self.follow {self.follow-current();}}
        for line[index] in AppState.lyrics: Rectangle {
            y:AppState.lyric-offset(index,AppState.lyric-layout-revision)*1px;
            width:lyrics.width;
            height:max(68px,(AppState.lyric-offset(index+1,AppState.lyric-layout-revision) - AppState.lyric-offset(index,AppState.lyric-layout-revision))*1px);
            // Followed lyrics can use the row's blank padding when the actual
            // glyphs still fit. Manual scrolling reveals edges progressively.
            private property<length> ink-top:rendered.bitmap.width>0 ? rendered.ink-top*1px : max(0px,(self.height - AppState.lyric-font-size*1.2px)/2 - 3px);
            private property<length> ink-bottom:rendered.bitmap.width>0 ? rendered.ink-bottom*1px : self.height - self.ink-top;
            private property<bool> text-visible:self.y+self.ink-top+lyrics.content-y>=0px && self.y+self.ink-bottom+lyrics.content-y<=lyrics.height;
            visible:!lyrics.follow || AppState.active-line==index || self.height>lyrics.height || self.text-visible;
            private property<bool> in-view:self.y+self.height>=-lyrics.content-y - 84px && self.y<=-lyrics.content-y+lyrics.height+84px;
            private property<LyricRender> rendered:self.in-view ? AppState.lyric-render(index,AppState.lyric-render-revision) : AppState.lyric-render(-1,AppState.lyric-render-revision);
            private property<float> line-opacity:line.time<0 ? 0.84 : AppState.active-line==index ? 1 : abs(AppState.active-line - index)==1 ? 0.56 : 0.34;
            if in-view && rendered.bitmap.width==0: Text {x:0px;y:0px;width:parent.width;height:parent.height;text:line.text;color:root.ink;font-size:AppState.lyric-font-size*1px;font-weight:900;
                wrap:word-wrap;horizontal-alignment:center;vertical-alignment:center;
                opacity:parent.line-opacity;
                }
            if in-view && rendered.bitmap.width>0: karaoke := Rectangle {
                Image {x:0px;y:0px;width:parent.width;height:parent.height;source:rendered.bitmap;colorize:root.dark ? transparent : root.ink;image-fit:fill;opacity:line.time<0 ? 0.84 : AppState.active-line==index && line.words.length>0 ? 0.34 : AppState.active-line==index ? 1 : abs(AppState.active-line - index)==1 ? 0.56 : 0.34;}
                for span in (AppState.active-line==index ? rendered.spans : []): Rectangle {
                    private property<float> progress:AppState.active-line==index ? clamp((AppState.lyric-position - span.time)/max(1,span.end-time - span.time),0,1) : 0;
                    x:(span.x+(span.rtl ? span.width*(1 - self.progress) : 0))*1px;y:span.y*1px;
                    width:span.width*self.progress*1px;height:span.height*1px;clip:true;visible:AppState.active-line==index && self.progress>0;
                    Image {x:-parent.x;y:-parent.y;width:karaoke.width;height:karaoke.height;source:rendered.bitmap;colorize:root.dark ? transparent : root.ink;image-fit:fill;}
                }
            }
            PlayerDragArea {activity=>{root.activity();}tapped => {if line.time>=0 {AppState.seek(line.time);lyrics.follow=true;resume-follow.stop();}}
                scroll-event(event)=>{
                    if abs(event.delta-x) > abs(event.delta-y) * 1.5 {
                        AppState.player-swipe(event.delta-x / 1px,event.delta-y / 1px);
                    } else {
                        lyrics.wheel-scroll(event.delta-y);
                    }
                    return accept;
                }}
        }
    }
    if AppState.lyrics.length==0: Rectangle {
        VerticalLayout {
            y:(parent.height - self.height)/2;width:parent.width;
            height:root.retryable ? 108px : 48px;
            spacing:12px;alignment:center;
            Text {
                height:48px;
                text:AppState.lyrics-refreshing ? "Just a sec, fetching lyrics..." : AppState.lyrics-status;
                color:root.ink.with-alpha(0.72);
                font-size:18px*AppState.scale;
                horizontal-alignment:center;
                vertical-alignment:center;
                wrap:word-wrap;
            }
            if root.retryable && !AppState.lyrics-refreshing: Rectangle {
                height:40px;
                TextButton {
                    x:(parent.width - self.width)/2;
                    layer:AppState.full-player ? "full" : "browse";
                    dark:root.dark;
                    text:"Try again";
                    clicked=>{AppState.lyrics-refreshing=true;AppState.refresh-lyrics();}
                }
            }
        }
    }
}

export component InlineLyricsPanel inherits Rectangle {
    in property<length> panel-width;
    in property<length> panel-height;
    in property<bool> overlay:false;
    width:root.panel-width;
    height:root.panel-height;
    background:root.overlay ? AppState.base : transparent;
    Rectangle {x:0px;width:1px;height:parent.height;background:AppState.ink.with-alpha(0.12);}
    Text {x:20px;y:16px;width:parent.width - 76px;height:32px;text:"LYRICS";color:AppState.ink.with-alpha(0.65);font-size:12px;font-weight:700;vertical-alignment:center;}
    IconButton {label:"Refresh lyrics";x:parent.width - 96px;y:12px;width:32px;height:32px;icon:Icons.refresh;enabled:AppState.now.path!="" && !AppState.lyrics-refreshing;clicked=>{AppState.lyrics-refreshing=true;AppState.refresh-lyrics();}}
    IconButton {label:"Close lyrics";x:parent.width - 56px;y:12px;width:32px;height:32px;icon:Icons.close;clicked=>{AppState.lyrics-open=false;}}
    LyricsViewport {x:20px;y:60px;width:parent.width - 40px;height:parent.height - 76px;font-size:clamp(root.width*0.065,23px,30px)*AppState.scale;}
}

export component PlaylistPicker inherits Rectangle {
    in property<bool> dark:false;
    private property<color> ink:root.dark ? white : AppState.ink;
    private property<color> accent:root.dark ? AppState.player-accent : AppState.accent;
    width:300px;
    height:min(392px,max(172px,AppState.playlist-choices.length*44px+108px));
    background:root.dark ? #171719 : AppState.panel;border-radius:8px;border-width:1px;border-color:root.ink.with-alpha(0.1020);
    Text {x:16px;y:12px;width:parent.width - 56px;height:24px;text:"Add to playlist";color:root.ink;font-size:15px;font-weight:700;overflow:elide;}
    Text {x:16px;y:36px;width:parent.width - 32px;height:18px;text:AppState.now.title;color:root.ink.with-alpha(0.65);font-size:12px;overflow:elide;}
    IconButton {layer:"menu";label:"Close";dark:root.dark;x:parent.width - 40px;y:8px;width:28px;height:28px;icon-size:16px;icon:Icons.close;clicked=>{AppState.playlist-picker-open=false;}}
    if AppState.playlist-picker-loading && AppState.playlist-choices.length==0: Text {x:16px;y:60px;width:parent.width - 32px;height:24px;text:"Loading playlists…";color:root.ink.with-alpha(0.65);font-size:12px;vertical-alignment:center;}
    if !AppState.playlist-picker-loading && AppState.playlist-choices.length==0: Text {x:16px;y:60px;width:parent.width - 32px;height:24px;text:"No playlists yet";color:root.ink.with-alpha(0.65);font-size:12px;vertical-alignment:center;}
    if AppState.playlist-choices.length>0: ListView {x:8px;y:60px;width:parent.width - 16px;height:parent.height - 108px;horizontal-scrollbar-policy:always-off;
        for playlist in AppState.playlist-choices: Rectangle {
            height:44px;border-radius:6px;background:pointer.has-hover ? root.ink.with-alpha(0.0706) : transparent;
            accessible-role:button;accessible-label:(playlist.selected ? "Remove from " : "Add to ")+playlist.title;
            accessible-action-default=>{AppState.playlist-action(playlist.selected ? "remove-current" : "add-current",playlist.key);}
            row-focus:=ActionFocus {layer:"menu";activated=>{AppState.playlist-action(playlist.selected ? "remove-current" : "add-current",playlist.key);}}
            Text {x:12px;width:parent.width - 50px;height:parent.height;text:playlist.title;color:root.ink;font-size:13px;overflow:elide;vertical-alignment:center;}
            Rectangle {x:parent.width - 28px;y:13px;width:18px;height:18px;border-radius:9px;border-width:1px;border-color:root.ink.with-alpha(0.48);background:playlist.selected ? root.accent : transparent;
                if playlist.selected: Text {text:"✓";color:root.dark ? black : AppState.inverse-ink;font-size:12px;font-weight:700;horizontal-alignment:center;vertical-alignment:center;}}
            pointer:=TouchArea {clicked=>{AppState.playlist-action(playlist.selected ? "remove-current" : "add-current",playlist.key);}}
        }
    }
    TextButton {layer:"menu";dark:root.dark;x:12px;y:parent.height - 44px;width:parent.width - 24px;height:32px;text:"New playlist";clicked=>{AppState.playlist-action("new-dialog","");}}
}

component QualityBadge inherits Rectangle {
    in property<string> text;
    in property<color> ink;
    width:quality-label.preferred-width+18px;height:22px;border-radius:5px;
    border-width:1px;border-color:root.ink.with-alpha(0.18);background:transparent;
    quality-label:=Text {x:9px;y:0px;height:parent.height;text:root.text;color:root.ink.with-alpha(0.82);font-size:10px*AppState.scale;font-weight:600;vertical-alignment:center;}
}

export component FullPlayer inherits Rectangle {
    private property<color> ink:AppState.full-player-dark ? white : AppState.ink;
    private property<bool> compact-lyrics:AppState.lyrics-open && root.width<1100px;
    private property<bool> spacious-lyrics:AppState.lyrics-open && root.width>=1600px && root.height>=900px;
    background:AppState.full-player-dark ? #090a0c : AppState.base;
    if AppState.full-player-background=="artwork": AmbientBackground {source:AppState.full-backdrop;strength:0.78;subtle:false;animate:false;}
    if AppState.full-player-background=="color": Rectangle {
        private property<color> tone:AppState.background-accent;
        animate tone {duration:320ms;easing:ease-in-out;}
        background:self.tone.with-alpha(0.82);
        Rectangle {background:@linear-gradient(180deg,#090a0c22,transparent 45%,#090a0c44);}
    }
    // Consume all empty-space input; the library is separately disabled.
    PlayerDragArea {}
    IconButton {layer:"full";label:"Back";dark:AppState.full-player-dark;x:56px;y:52px;icon:Icons.back;round:true;outlined:true;clicked => {AppState.full-player=false;}}
    IconButton {layer:"full";label:"Lyrics";dark:AppState.full-player-dark;x:parent.width - 136px;y:52px;icon:Icons.lyrics;round:true;active:AppState.lyrics-open;clicked => {AppState.lyrics-open=!AppState.lyrics-open;if AppState.lyrics-open {AppState.queue-open=false;}}}
    IconButton {layer:"full";label:"Queue";dark:AppState.full-player-dark;x:parent.width - 88px;y:52px;icon:Icons.queue;round:true;active:AppState.queue-open;clicked => {AppState.queue-open=!AppState.queue-open;if AppState.queue-open {AppState.command("queue-preview",0);}}}
    content := Rectangle {
        visible:!root.compact-lyrics;
        x:AppState.lyrics-open ? clamp(root.width*0.09,64px,176px) : (root.width - self.width)/2;
        y:104px;width:AppState.lyrics-open ? min(root.spacious-lyrics ? 460px : 390px,root.width*0.36) : min(560px,root.width - 112px);height:root.height - 176px;
        VerticalLayout {
            spacing:0;alignment:center;
            if AppState.full-artwork: Rectangle {
                height:min(content.width,AppState.lyrics-open ? root.spacious-lyrics ? 420px : 340px : 396px,max(96px,content.height - (root.height<720px ? 240px : 320px)));
                changed height=>{AppState.player-cover-size=self.height/1px;}
                init=>{AppState.player-cover-size=self.height/1px;}
                Rectangle {x:(parent.width - self.width)/2;y:0px;width:parent.height;height:parent.height;
                    CoverImage {x:AppState.player-swipe-offset*1px;y:0px;width:parent.width;height:parent.height;artwork:AppState.original-cover;missing:AppState.original-cover-missing;image-fit:cover;
                        animate x {duration:95ms;easing:ease-out;}}
                    PlayerDragArea {}
                }
            }
            Rectangle {height:root.height<720px ? 12px : 20px;}
            if AppState.lyrics-open: Text {text:AppState.now.title;color:root.ink;font-size:(root.height<720px ? 28px : 30px)*AppState.scale;font-weight:900;horizontal-alignment:center;overflow:elide;}
            if !AppState.lyrics-open: Rectangle {height:root.height<720px ? 36px : 48px;
                Text {x:(parent.width - self.width)/2;width:root.width - 112px;height:parent.height;text:AppState.now.title;color:root.ink;font-size:(root.height<720px ? 28px : 36px)*AppState.scale;font-weight:900;horizontal-alignment:center;vertical-alignment:center;overflow:elide;
                    Tooltip {text:@markdown("\{AppState.now.title}");}
                }
            }
            Rectangle {height:root.height<720px ? 4px : 8px;}
            HorizontalLayout {height:24px*AppState.scale;spacing:8px;alignment:center;
                artist-label:=Text {width:min(self.preferred-width,AppState.now.album=="" ? parent.width : parent.width*0.48);overflow:elide;text:AppState.now.artist;color:root.ink.with-alpha(0.8157);font-size:(root.height<720px ? 14px : AppState.lyrics-open ? 16px : 18px)*AppState.scale;vertical-alignment:center;
                    TouchArea {enabled:AppState.now.artist!="";clicked=>{AppState.unfocus();AppState.full-player=false;AppState.view="artists";AppState.open-group(AppState.now.artist,"",AppState.now.artist);}}}
                if AppState.now.album!="": Text {text:"-";color:root.ink.with-alpha(0.8);font-size:(root.height<720px ? 14px : AppState.lyrics-open ? 16px : 18px)*AppState.scale;vertical-alignment:center;}
                if AppState.now.album!="": Text {width:min(self.preferred-width,max(0px,parent.width - artist-label.width - 24px*AppState.scale));text:AppState.now.album;color:root.ink.with-alpha(0.7529);font-size:(root.height<720px ? 14px : AppState.lyrics-open ? 16px : 18px)*AppState.scale;vertical-alignment:center;overflow:elide;
                    Tooltip {text:@markdown("\{AppState.now.album}");}
                    TouchArea {clicked=>{AppState.unfocus();AppState.full-player=false;AppState.view="albums";AppState.open-group(AppState.now.album,AppState.now.album-artist,AppState.now.album);}}}
            }
            Rectangle {height:root.height<720px ? 8px : 16px;}
            if AppState.quality-info: Rectangle {height:22px;
                QualityBadge {x:(parent.width - self.width)/2;text:AppState.now.quality;ink:root.ink;}
            }
            Rectangle {height:root.height<720px ? 16px : 32px;}
            SeekBar {dark:AppState.full-player-dark;stacked:true;height:root.height<720px ? 60px : 72px;}
            Rectangle {height:root.height<720px ? 8px : 20px;}
            HorizontalLayout {
                height:root.height<720px ? 44px : content.width>=384px ? 56px : AppState.lyrics-open ? 44px : 52px;
                spacing:8px;
                alignment:center;
                if AppState.show-liked-songs: IconButton {layer:"full";label:AppState.liked ? "Unlike song" : "Like song";dark:AppState.full-player-dark;icon:AppState.liked ? Icons.heartFilled : Icons.heart;icon-size:root.spacious-lyrics ? 22px : 20px;width:root.spacious-lyrics ? 48px : 40px;height:self.width;round:true;active:AppState.liked;active-icon-only:true;enabled:AppState.now.id>0;clicked=>{AppState.toggle-like();}}
                PlaybackControls {layer:"full";dark:AppState.full-player-dark;large:!AppState.lyrics-open && root.height>=720px;prominent:root.height>=720px && content.width>=384px;width:!AppState.lyrics-open && self.prominent ? 304px : root.spacious-lyrics ? 300px : self.prominent ? 288px : root.height<720px || AppState.lyrics-open ? 252px : 276px;}
                IconButton {layer:"full";label:"Add to playlist";dark:AppState.full-player-dark;icon:Icons.playlistAdd;icon-size:root.spacious-lyrics ? 22px : 20px;width:root.spacious-lyrics ? 48px : 40px;height:self.width;round:true;active:AppState.playlist-picker-open;enabled:AppState.now.id>0;clicked=>{if AppState.playlist-picker-open {AppState.playlist-picker-open=false;} else {AppState.playlist-action("open-current","");AppState.queue-open=false;}}}
            }
        }
    }
    if AppState.lyrics-open && !root.compact-lyrics: LyricsViewport {
        x:content.x+content.width+32px;y:104px;width:root.width - self.x - 56px;height:root.height - 136px;
        font-size:clamp(root.width*0.0265,30.4px,50.4px)*AppState.scale;dark:AppState.full-player-dark;
    }
    if root.compact-lyrics: Rectangle {
        x:56px;y:108px;width:root.width - 112px;height:230px;
        private property<length> art-size:root.height<720px ? 84px : 112px;
        private property<length> details-x:AppState.full-artwork ? self.art-size+20px : 0px;
        if AppState.full-artwork: Rectangle {x:0px;y:0px;width:parent.art-size;height:parent.art-size;
            CoverImage {x:AppState.player-swipe-offset*1px;width:parent.width;height:parent.height;artwork:AppState.original-cover;missing:AppState.original-cover-missing;image-fit:cover;
                animate x {duration:95ms;easing:ease-out;}}
            PlayerDragArea {}
        }
        Text {x:parent.details-x;y:0px;width:parent.width - self.x;height:36px;text:AppState.now.title;color:root.ink;font-size:26px*AppState.scale;font-weight:900;overflow:elide;vertical-alignment:center;}
        Text {x:parent.details-x;y:38px;width:parent.width - self.x;height:21px;text:AppState.now.artist;color:root.ink.with-alpha(0.82);font-size:15px*AppState.scale;overflow:elide;vertical-alignment:center;}
        if AppState.now.album!="": Text {x:parent.details-x;y:61px;width:parent.width - self.x;height:17px;text:AppState.now.album;color:root.ink.with-alpha(0.75);font-size:12px*AppState.scale;overflow:elide;vertical-alignment:center;}
        if AppState.quality-info: QualityBadge {x:parent.details-x;y:83px;text:AppState.now.quality;ink:root.ink;}
        HorizontalLayout {x:parent.details-x;y:113px;height:56px;spacing:8px;alignment:start;
            if AppState.show-liked-songs && root.width>=720px: IconButton {layer:"full";label:AppState.liked ? "Unlike song" : "Like song";dark:AppState.full-player-dark;icon:AppState.liked ? Icons.heartFilled : Icons.heart;round:true;active:AppState.liked;active-icon-only:true;enabled:AppState.now.id>0;clicked=>{AppState.toggle-like();}}
            PlaybackControls {layer:"full";dark:AppState.full-player-dark;prominent:root.width>=640px;width:root.width>=640px ? 288px : 252px;}
            if root.width>=720px: IconButton {layer:"full";label:"Add to playlist";dark:AppState.full-player-dark;icon:Icons.playlistAdd;round:true;active:AppState.playlist-picker-open;enabled:AppState.now.id>0;clicked=>{if AppState.playlist-picker-open {AppState.playlist-picker-open=false;} else {AppState.playlist-action("open-current","");AppState.queue-open=false;}}}
        }
        SeekBar {x:0px;y:177px;width:parent.width;height:53px;dark:AppState.full-player-dark;stacked:true;}
    }
    if root.compact-lyrics: LyricsViewport {
        x:56px;y:352px;width:root.width - 112px;height:root.height - 384px;
        font-size:clamp(root.width*0.035,28px,38px)*AppState.scale;dark:AppState.full-player-dark;
    }
    VolumeControl {layer:"full";dark:AppState.full-player-dark;x:parent.width - 72px;y:parent.height - 72px;}
}

export component QueuePanel inherits Rectangle {
    private property<color> ink:AppState.full-player && AppState.full-player-dark ? white : AppState.ink;
    in property <length> available-width:1280px;
    in property <length> available-height:820px;
    in property<bool> docked:false;
    in property<bool> overlay:false;
    in property<length> dock-width:384px;
    in property<length> dock-height:672px;
    width:root.docked ? root.dock-width : min(384px,root.available-width - 32px);height:root.docked ? root.dock-height : min(672px,root.available-height - 32px,80px+max(1,AppState.queue.length)*(AppState.browse-artwork ? 67.2px : 56px));
    border-radius:root.docked ? 0px : 21.6px;clip:true;background:root.docked ? root.overlay ? AppState.base : transparent : AppState.full-player && AppState.full-player-dark ? #000 : AppState.queue-background;border-width:root.docked ? 0px : 1px;border-color:root.ink.with-alpha(0.1020);
    if root.docked: Rectangle {x:0px;width:1px;height:parent.height;background:root.ink.with-alpha(0.12);}
    private property<string> dragged-path;
    private property<float> drag-origin;
    private property<bool> drag-moved;

    Text {x:20px;y:18px;text:"Queue";color:root.ink;font-size:19.52px;font-weight:900;}
    Text {x:20px;y:44px;text:AppState.shuffle ? "Shuffle is on" : max(0,AppState.queue.length - 1)+" up next";color:root.ink.with-alpha(AppState.light-theme && !(AppState.full-player && AppState.full-player-dark) ? max(0.65,0.4510) : 0.4510);font-size:12px;}
    TextButton {layer:root.docked ? "browse" : "queue";dark:AppState.full-player && AppState.full-player-dark;x:parent.width - 128px;y:20px;width:64px;height:36px;text:"Clear";clicked => {AppState.queue-action("clear","","");}}
    IconButton {layer:root.docked ? "browse" : "queue";label:"Close";dark:AppState.full-player && AppState.full-player-dark;x:parent.width - 56px;y:20px;width:36px;height:36px;icon:Icons.close;round:true;outlined:!root.docked;clicked => {AppState.queue-open=false;}}
    queue-list:=ListView {x:12.8px;y:80px;width:parent.width - 25.6px;height:parent.height - 92.8px;horizontal-scrollbar-policy:always-off;
        for song[index] in AppState.queue: Rectangle {
            accessible-role:button;accessible-label:song.title+", "+song.artist;
            row-focus:=ActionFocus {layer:root.docked ? "browse" : "queue";activated=>{AppState.queue-action("play",song.path,"");}
                key-pressed(event)=>{
                    if event.text==Key.Delete {AppState.queue-action("remove",song.path,"");return accept;}
                    if event.modifiers.alt && event.text==Key.UpArrow && index>0 {AppState.queue-action("move",song.path,AppState.queue[index - 1].path);return accept;}
                    if event.modifiers.alt && event.text==Key.DownArrow && index+1<AppState.queue.length {AppState.queue-action("move",song.path,AppState.queue[index+1].path);return accept;}
                    if event.text=="\n" || event.text==" " {if !event.repeat {AppState.queue-action("play",song.path,"");}return accept;}
                    return reject;
                }
            }
            border-width:row-focus.has-focus ? 2px : 0px;border-color:root.ink;

            height:AppState.browse-artwork ? 67.2px : 56px;border-radius:10px;background:song.path==AppState.now.path || pointer.has-hover ? root.ink.with-alpha(0.0549) : transparent;
            HorizontalLayout {padding:9.6px;spacing:12px;
                if AppState.browse-artwork: Rectangle {width:48px;height:48px;border-radius:7.68px;clip:true;CoverImage {x:0px;y:0px;width:parent.width;height:parent.height;artwork:song.cover;missing:song.cover-missing;image-fit:cover;}}
                VerticalLayout {horizontal-stretch:1;spacing:1px;alignment:center;
                    Text {text:song.title;color:root.ink;font-size:14.72px;font-weight:700;overflow:elide;}
                    Text {text:song.artist;color:root.ink.with-alpha(AppState.light-theme && !(AppState.full-player && AppState.full-player-dark) ? max(0.65,0.4784) : 0.4784);font-size:12.48px;overflow:elide;}}
                Text {width:48px;horizontal-alignment:right;text:song.duration;color:root.ink.with-alpha(AppState.light-theme && !(AppState.full-player && AppState.full-player-dark) ? max(0.65,0.4784) : 0.4784);font-size:13.44px;vertical-alignment:center;}
            }
            pointer := TouchArea {
                moved=> {if self.pressed && abs(self.mouse-y/1px - root.drag-origin)>5 {root.drag-moved=true;}}
                pointer-event(event) => {
                    if event.button==PointerEventButton.right && event.kind==PointerEventKind.down {AppState.queue-action("remove",song.path,"");}
                    if event.button==PointerEventButton.left && event.kind==PointerEventKind.down {root.dragged-path=song.path;root.drag-origin=self.mouse-y/1px;root.drag-moved=false;}
                    if event.button==PointerEventButton.left && event.kind==PointerEventKind.up {
                        if root.drag-moved {let target=clamp(index+round((self.mouse-y/1px - root.drag-origin)/(AppState.browse-artwork ? 67.2 : 56)),0,AppState.queue.length - 1);AppState.queue-action("move",root.dragged-path,AppState.queue[target].path);}
                        else {AppState.queue-action("play",song.path,"");}
                        root.dragged-path="";root.drag-moved=false;
                    }
                }
            }
        }
    }
}
