export struct Song {
    id: int, path: string, title: string, artist: string, album: string, album-artist: string, duration: string, quality: string, cover: image, cover-missing: bool, explicit: bool, liked: bool, bit-depth: int, index: int,
}

export struct CatalogGroup {
    key: string, secondary: string, title: string, subtitle: string, count: int, cover: image, cover-missing: bool, accent: color, year: int,
}

export struct SongGridRow {
    index: int,cells: [Song],
}

export struct SidebarEntry {
    page: string,label: string,icon: image,shown: bool,
}

export struct ArtistCredit {
    text: string, key: string,
}

export struct PlaylistChoice {
    key: string, title: string, selected: bool,
}

export struct OutputChoice {
    id: string, name: string,
}

export struct FolderChoice {
    path: string, name: string, mode: string, included: bool, has-children: bool,
}

export struct FolderRuleDraft {
    path: string, mode: string,
}

export struct RomanizationLanguage {
    code: string,name: string,selected: bool,
}

export struct LyricWord {
    text: string,time: float,end-time: float,
}

export struct LyricLine {
    text: string, time: float, words: [LyricWord],
}

export struct LyricSpan {
    x: float,y: float,width: float,height: float,time: float,end-time: float,rtl: bool,caption: bool,
}

export struct LyricRender {
    bitmap: image,blurred: image,padding: float,height: float,ink-top: float,ink-bottom: float,ink-left: float,ink-right: float,spans: [LyricSpan],
}

export struct MetadataDraft {
    path: string,title: string,artist: string,album: string,album-artist: string, year: string,track-number: string,disc-number: string,genre: string,lyrics: string, composer: string,comment: string,advisory: int,advanced-changed: bool, artwork: string,cover-to-embed: string,remove-cover: bool,file-version: string,
}

export global AppState {
    in-out property<bool> windows-audio: true;
    in-out property<bool> keyboard-navigation: false;
    in-out property<float> display-dpr: 1;
    in-out property<bool> software-rendering: true;
    out property<string> focus-layer: modal-open ? "dialog" : DialogState.menu-open || DialogState.collection-menu-open || DialogState.playlist-picker-open ? "menu" : PlayerState.queue-open && PlayerState.full-player ? "queue" : PlayerState.full-player ? "full" : "browse";
    public pure function layer-enabled(layer: string)->bool {
        return focus-layer==layer || (layer=="full" && focus-layer=="queue");
    }
    out property<bool> modal-open: DialogState.audio-info-open || DialogState.metadata-open || DialogState.collection-dialog || DialogState.playlist-dialog || DialogState.folder-dialog || DialogState.folder-remove-open;
    in-out property<bool> tray-available;
    in-out property<bool> phantom-global;
    in-out property<bool> window-hidden;
    callback phantom();
    in-out property <string> view: "songs";
    in-out property <bool> text-input-focused;
    in-out property <string> error;
    in-out property<string> app-version;
    callback report-issue();
    callback unfocus();
    in-out property<int> search-focus-request: 0;
    in-out property<bool> search-focus-pending: false;
    in-out property<bool> search-input-focused: false;
    callback keyboard(string,bool)->bool;
    pure callback display-path(string)->string;
}

export global LibraryState {
    in-out property<int> detail-year;
    in-out property<color> detail-accent: white;
    in-out property <string> search;
    in-out property<bool> catalog-loading;
    in-out property<int> known-artists: -1;
    in-out property<int> known-albums: -1;
    in-out property<int> known-genres: -1;
    in-out property<int> known-playlists: -1;
    in-out property <string> sort: "artist";
    // Collection sorting is temporary; opening another collection restores its natural order.
    in-out property<string> detail-sort;
    out property<string> table-sort: detail-key=="" ? sort : detail-sort;
    in-out property <bool> playlist-selection-mode: false;
    in-out property <int> playlist-selection-count: 0;
    in-out property <int> playlist-selection-revision: 0;
    in-out property <string> detail-key;
    in-out property <string> detail-secondary;
    in-out property <string> detail-title;
    in-out property <string> detail-summary;
    in-out property <image> detail-cover;
    in-out property <image> detail-backdrop;
    in-out property <[[CatalogGroup]]> related-albums;
    in-out property <int> related-columns: 2;
    in-out property <string> summary: "Loading library…";
    in-out property <string> catalog-summary;
    in-out property<int> song-first;
    in-out property<int> song-end: 32;
    in-out property<float> artwork-scroll-position;
    in-out property<int> library-scroll-index;
    in-out property<float> library-scroll-fraction;
    in-out property<bool> library-view-restore;
    in-out property <[Song]> songs;
    in-out property <[[Song]]> song-grid;
    pure callback new-grid-window()->[SongGridRow];
    pure callback prepare-grid-window([SongGridRow],[[Song]],int,int)->int;
    callback apply-grid-window([SongGridRow],int);
    in-out property <[[CatalogGroup]]> group-grid;
    in-out property <bool> detail-cover-missing;
    in-out property <bool> artwork-bulk-started: false;
    in-out property <bool> artwork-bulk-running: false;
    in-out property <bool> artwork-bulk-complete: false;
    in-out property <string> artwork-bulk-progress;
    callback artwork-bulk(string);
    in-out property <int> columns: 6;
    in-out property <int> image-edge: 192;
    in-out property <int> group-columns: 1;
    in-out property <int> jump-index: -1;
    in-out property <int> jump-revision;
    in-out property <float> catalog-scroll-y;
    in-out property <float> catalog-scroll-target;
    in-out property <int> catalog-scroll-restore-revision;
    in-out property <bool> catalog-scroll-restore-pending;
    in-out property <[CatalogGroup]> playlists;
    in-out property <[string]> folders;
    callback browse();
    callback open-collection(string, string, string);
    pure callback artist-names(string, string)->[ArtistCredit];
    callback add-folder();
    callback refresh();
    callback folder-action(string, string);
    callback open-group(string, string, string);
    callback go-back();
    callback playlist-selection(string, int);
    pure callback playlist-song-selected(int, int)->bool;
}

export global PlayerState {
    in-out property<color> player-accent: white;
    in-out property<color> background-accent: #626262;
    in-out property <string> collection-path;
    in-out property <bool> full-player: false;
    in-out property <bool> queue-open: false;
    in-out property <bool> liked: false;
    in-out property <[Song]> queue;
    in-out property<float> player-cover-size: 396;
    in-out property<float> player-swipe-offset: 0;
    in-out property <Song> now;
    in-out property <image> original-cover;
    in-out property <bool> original-cover-missing;
    pure callback compact-quality(string)->string;
    compact-quality(quality)=>{
        return quality;
    }
    out property<string> display-quality: compact-quality(now.quality);
    in-out property <image> backdrop;
    in-out property <image> full-backdrop;
    in-out property <image> waveform;
    in-out property <bool> playing;
    in-out property <bool> shuffle;
    in-out property <int> repeat;
    in-out property <float> position;
    in-out property <float> duration;
    in-out property <float> volume: 1;
    in-out property <string> elapsed: "0:00";
    in-out property <string> total: "3:00";
    in-out property<string> output-device-id;
    in-out property<bool> output-exclusive: false;
    in-out property<bool> output-unprocessed: false;
    in-out property<[OutputChoice]> output-choices;
    in-out property<[string]> output-names: ["System default"];
    in-out property<int> output-device-index: 0;
    in-out property<string> output-error;
    in-out property<string> output-notice;
    in-out property<string> audio-error-banner;
    in-out property<string> output-device-name;
    in-out property<string> output-sample-format;
    in-out property<int> output-rate;
    in-out property<int> output-source-rate;
    in-out property<int> output-channels;
    in-out property<bool> output-active-exclusive;
    in-out property<bool> output-active-unprocessed;
    in-out property<bool> output-switching;
    out property<bool> output-open: output-rate>0 && output-channels>0 && !output-switching;
    out property<string> output-requested-mode-label: !AppState.windows-audio ? "System output" : output-unprocessed ? "Unprocessed exclusive" : output-exclusive ? "WASAPI exclusive" : "WASAPI shared";
    out property<string> output-mode-label: output-switching ? "Switching output..." : !output-open ? "No active output" : !AppState.windows-audio ? "System output" : output-active-unprocessed ? "Unprocessed exclusive" : output-active-exclusive ? "WASAPI exclusive" : "WASAPI shared";
    out property<string> output-format-label: output-rate>0 ? (output-rate/1000.0)+" kHz · "+output-channels+" ch · "+output-sample-format : "No active output";
    out property<string> output-rate-path: output-open && output-source-rate>0 ? (output-source-rate==output-rate ? "Native sample rate" : (output-source-rate/1000.0)+" kHz → "+(output-rate/1000.0)+" kHz") : "";
    out property<string> processing-summary: !output-open ? "No active processing" : output-active-unprocessed ? "Integer PCM · DSP bypassed" : "32-bit float processing";
    out property<string> processing-controls: !output-open ? "" : output-active-unprocessed ? "App volume fixed at 100%; use device volume" : "App volume "+round(volume*100)+"% · "+(PreferencesState.replaygain ? "ReplayGain enabled" : "ReplayGain off");
    out property<string> audio-tooltip: (output-open ? output-mode-label+"\n"+output-format-label : output-mode-label)+"\nClick for audio details";
    callback refresh-outputs();
    callback retry-output();
    callback select-output(int);
    in-out property<bool> player-idle: false;
    in-out property<bool> player-interacting: false;
    in-out property<bool> player-hovering-controls: false;
    in-out property<int> player-activity-sequence: 0;
    public function player-activity() {
        player-idle=false;
        player-activity-sequence+=1;
    }
    callback play(string);
    callback play-group(CatalogGroup, string);
    callback like-song(int);
    in-out property<string> playback-kind;
    in-out property<string> playback-key;
    in-out property<string> playback-secondary;
    public pure function collection-playing(kind: string,key: string,secondary: string)->bool {
        return playing && now.path!="" && playback-kind==kind && playback-key==key && playback-secondary==secondary;
    }
    callback command(string, float);
    callback player-swipe(float, float) -> bool;
    callback player-drag(float, float) -> bool;
    callback seek(float);
    callback volume-changed(float);
    callback queue-action(string, string, string);
    callback toggle-like();
}

export global LyricsState {
    in-out property <bool> lyrics-open: false;
    in-out property <bool> lyrics-refreshing: false;
    in-out property <[LyricLine]> lyrics;
    in-out property <float> lyrics-width;
    in-out property <float> lyric-font-size: 40;
    in-out property <int> lyric-render-revision;
    in-out property <int> lyric-layout-revision;
    in-out property <int> active-line: - 1;
    in-out property<float> lyric-position: PlayerState.position;
    in-out property <string> lyrics-status;
    callback refresh-lyrics();
    pure callback lyric-render(int,int)->LyricRender;
    pure callback lyric-offset(int,int)->float;
}

export global PreferencesState {
    in-out property<bool> sidebar-songs: true;
    in-out property<bool> sidebar-artists: true;
    in-out property<bool> sidebar-albums: true;
    in-out property<bool> sidebar-genres: true;
    in-out property<bool> sidebar-playlists: true;
    in-out property<bool> sidebar-folders: true;
    in-out property<bool> sidebar-composers: false;
    in-out property<bool> sidebar-years: false;
    in-out property<bool> light-theme: false;
    out property<bool> full-player-dark: !light-theme || full-player-background!="off";
    out property<color> ink: light-theme ? #242321 : white;
    out property<color> table-secondary-ink: ink.with-alpha(0.68);
    out property<color> secondary-ink: ink.with-alpha(0.74);
    out property<color> inverse-ink: light-theme ? #FCFBF7 : black;
    out property<color> base: light-theme ? #FCFBF7 : #090a0c;
    out property<color> panel: light-theme ? #F3F1EA : #141414;
    out property<color> raised-panel: light-theme ? #F8F6F0 : #171719;
    out property<color> queue-background: light-theme ? #F8F6F0 : #000;
    in-out property <bool> browse-artwork: true;
    in-out property <bool> compact-artwork: true;
    in-out property <bool> full-artwork: true;
    in-out property <bool> grid: true;
    in-out property <bool> folder-grid: true;
    in-out property <bool> show-liked-songs: true;
    in-out property <color> accent: #b09caa;
    in-out property <float> scale: 1;
    in-out property <string> font-family: "Plus Jakarta Sans";
    in-out property <string> font-path;
    in-out property <string> custom-font-family;
    in-out property <bool> quality-info: true;
    in-out property <bool> lyrics-left-aligned: false;
    in-out property <bool> soft-lyric-sweep: false;
    in-out property <bool> blur-unfocused-lyrics: false;
    in-out property <float> lyrics-blur-strength: 30;
    in-out property <int> romanization-mode: 0;
    in-out property <[RomanizationLanguage]> romanization-languages;
    in-out property <int> romanization-selected-count: 0;
    callback romanization-language(string,bool);
    in-out property <bool> show-tooltips: true;
    in-out property <bool> replaygain: false;
    in-out property <bool> dynamic-accent: true;
    in-out property <bool> blurred-background: false;
    in-out property <string> full-player-background: "soft-artwork";
    in-out property<bool> auto-hide-player-controls: false;
    in-out property <bool> gapless: true;
    in-out property <bool> auto-artwork: false;
    in-out property <bool> icon-sidebar: true;
    in-out property <string> seek-style: "waveform";
    callback save-settings();
    callback font-action(string);
    pure callback setting-matches(string,string)->bool;
    callback font-scale(string);
}

